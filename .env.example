# =============================================================================
# Nyaya Revolution — Environment Variables
# =============================================================================
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Rules:
# - NEVER commit `.env.local` or any file containing real secrets.
# - Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# - All other variables are server-only and must never be imported in client code.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js — Application
# -----------------------------------------------------------------------------

# Public base URL of the app (used for metadata, emails, OAuth redirects, sitemap).
# Local:  http://localhost:3000
# Prod:   https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime environment label (Next.js sets this automatically in most cases).
# Values: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase — Database, Auth & Storage (client-safe keys)
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Found in: Supabase Dashboard → Project Settings → API → Project URL
# Safe to expose: yes (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous (public) key — used in browser and server components.
# Row Level Security (RLS) policies protect data; this key alone is not admin access.
# Found in: Supabase Dashboard → Project Settings → API → anon public
# Safe to expose: yes (public, with RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Supabase — Server-only (NEVER expose to client)
# -----------------------------------------------------------------------------

# Supabase service role key — bypasses RLS. Use ONLY in server-side code
# (Route Handlers, Server Actions, background jobs, seed scripts).
# Found in: Supabase Dashboard → Project Settings → API → service_role
# Safe to expose: NO — server-only secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection string (optional).
# Use for migrations, Prisma/Drizzle CLI, or server-side raw SQL — not in browser.
# Found in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Safe to expose: NO — server-only secret
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Google Gemini — AI (server-only)
# -----------------------------------------------------------------------------

# Google Gemini API key for AI features (tutoring, feedback, search, authoring assist).
# Used only in server-side Route Handlers or Server Actions — never in client bundles.
# Found in: Google AI Studio → https://aistudio.google.com/apikey
# Safe to expose: NO — server-only secret
GEMINI_API_KEY=your-gemini-api-key

# Default Gemini model identifier (optional override).
# Examples: gemini-2.0-flash | gemini-1.5-pro
# Safe to expose: yes (non-secret configuration)
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Optional — Auth redirect (Supabase OAuth / magic links)
# -----------------------------------------------------------------------------

# Canonical site URL for Supabase auth callbacks when it differs from APP_URL.
# Usually matches NEXT_PUBLIC_APP_URL in development.
# Safe to expose: yes (public)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

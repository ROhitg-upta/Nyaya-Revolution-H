# =============================================================================
# Nyaya Revolution — Environment Variables Configuration
# =============================================================================
# Duplicate this file to `.env.local` for local development.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables remain strictly server-side.

# -----------------------------------------------------------------------------
# 1. Application URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. Supabase Configuration (Database, Authentication, Storage, Realtime)
# -----------------------------------------------------------------------------
# Obtain these from your Supabase project dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SERVER-ONLY: Used for migrations, seed scripts, and admin tasks.
# NEVER expose this key to client components or public bundles.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Direct PostgreSQL connection string (for Prisma, Drizzle, or raw migrations if needed)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# 3. AI & LLM Service Configuration (Server-Only)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
